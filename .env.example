# Local development
APP_ENV=local
APP_BASE_URL=http://localhost:5173
SECRET_KEY=

# Postgres — local default uses the pgserver unix socket from scripts/dev_db.py
DATABASE_URL=postgresql+psycopg://postgres@/postgres?host=/tmp/customs-ai/pgdata

# Object storage. STORAGE_BACKEND=local for development, s3 for deployment.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=/tmp/customs-ai/storage
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=customs-ai-local
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# AI provider. AI_BACKEND=fixture for offline development,
# developer for a Gemini API key on synthetic documents only,
# vertex for production (regional processing, enterprise terms).
AI_BACKEND=fixture
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=asia-south1
VERTEX_MODEL=
AI_MONTHLY_CAP_PAISE=500000

# Limits
MAX_UPLOAD_MB=25
MAX_PAGES=40
SESSION_TTL_HOURS=8
RETENTION_DAYS=180

# Demo only — never used in production
DEMO_EXEC_PASSWORD=demo-exec-2026
DEMO_MANAGER_PASSWORD=demo-manager-2026
